DEPLOY_USER=deploy
DEPLOY_SSH_KEY=@~/.ssh/berlinesa_deploy
DEPLOY_KNOWN_HOSTS=@~/.config/gh-workflows/known_hosts
SERVICE_REPO_TOKEN=github_pat_...
